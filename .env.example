# Set this before setup for HTTPS behind your reverse proxy.
PUBLIC_ORIGIN=http://localhost:8080
# JSON maps stable SSO subjects to public profile names. These are optional.
MEMBER_ACCOUNTS={}
MEMBER_ADMINS=[]
MEMBER_ROLES=[]
MAX_UPLOAD_MB=64
# JSON list of reverse-proxy addresses or CIDR ranges whose X-Forwarded-For is trusted
# for per-client sign-in limits, e.g. ["172.18.0.1"]. Leave empty without a proxy.
TRUSTED_PROXIES=[]
